# --- Application ---
APP_NAME="Touche pas au klaxon"
APP_ENV=dev
APP_DEBUG=true
APP_TIMEZONE=Europe/Paris
APP_COPYRIGHT_HOLDER="Touche pas au klaxon"
# Port local de l'application (http://localhost:8085)
APP_PORT=8085

# --- Base de données de l'application ---
DB_HOST=db
DB_PORT=3306
DB_NAME=touche_pas_au_klaxon
DB_USER=klaxon_app
DB_PASSWORD=change-me-app

# --- Base de données des tests d'intégration ---
DB_TEST_NAME=touche_pas_au_klaxon_test
DB_TEST_USER=klaxon_test
DB_TEST_PASSWORD=change-me-test

# --- Administration MySQL (conteneur db uniquement) ---
MYSQL_ROOT_PASSWORD=change-me-root

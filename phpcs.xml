<?xml version="1.0"?>
<ruleset name="Touche pas au klaxon">
    <description>Norme de codage du projet : PSR-12.</description>

    <file>src</file>
    <file>config</file>
    <file>tests</file>
    <file>public/index.php</file>

    <exclude-pattern>tests/Fixtures/templates/*</exclude-pattern>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="130"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
    </rule>

    <!-- Les fichiers de configuration et le contrôleur frontal retournent ou exécutent du code : effets de bord attendus. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>config/*</exclude-pattern>
        <exclude-pattern>public/index.php</exclude-pattern>
        <exclude-pattern>src/Core/helpers.php</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
</ruleset>

{
  "name": "touche-pas-au-klaxon-assets",
  "private": true,
  "description": "Compilation des feuilles de style (Bootstrap + Sass) et copie des ressources front.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:css && npm run build:vendor",
    "build:css": "sass --style=compressed --no-source-map --load-path=node_modules --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function resources/scss/app.scss public/assets/css/app.css",
    "build:vendor": "node scripts/copy-vendor.mjs",
    "watch:css": "sass --watch --load-path=node_modules --quiet-deps --silence-deprecation=import,global-builtin,color-functions,if-function resources/scss/app.scss public/assets/css/app.css"
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "sass": "1.105.0"
  }
}
